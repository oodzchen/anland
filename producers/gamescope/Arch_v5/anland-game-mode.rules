// anland-game-mode hands the display back to the Droidspaces desktop session from a
// session without a polkit agent; allow exactly that unit for administrators.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "desktop-session.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "restart") &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
